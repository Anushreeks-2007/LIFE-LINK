# ==============================================================================
# LIFE-LINK Environment Configuration Example
# ==============================================================================

# Supabase Configuration
# If left empty or placeholder, LIFE-LINK runs in Demonstration Mode with local IndexedDB
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Map & Routing Configurations
# Defaults to public OpenStreetMap and Project-OSRM service with offline fallback
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Optional SMS / Notification Webhook (for production dispatch)
VITE_NOTIFICATION_PROVIDER_URL=https://your-project.supabase.co/functions/v1/notify-family
